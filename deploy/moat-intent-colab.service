[Unit]
Description=Moat intent reader backed by Colab Gemma
After=network-online.target moat-colab-queue-api.service
Wants=moat-colab-tunnel.service moat-colab-queue-api.service

[Service]
Type=simple
User=moat
Group=moat
WorkingDirectory=/var/lib/moat
ExecStart=/usr/local/bin/moat-intent --listen 127.0.0.1:7083 --llm-url http://127.0.0.1:8093 --gateway http://127.0.0.1:7082 --model gemma-4-E4B-it-qat-UD-Q4_K_XL --timeout-secs 130
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
