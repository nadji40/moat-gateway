# /etc/moat/moat-intent.env: which model moat-intent reads with.
# Install it root-only (chown root:root, chmod 600): it can hold an API key,
# which systemd reads as root and hands to the service. Never commit the real
# file. After changing it: systemctl restart moat-intent
#
# Every setting also has a command-line flag (--provider, --llm-url, --model,
# --effort, --timeout-secs) except the key, which is only ever read from the
# environment so it never shows in a process list.

# Claude, through Anthropic's Messages API.
MOAT_INTENT_PROVIDER=anthropic
MOAT_INTENT_MODEL=claude-opus-5-5
# How hard Claude thinks before answering: low, medium, high, xhigh, max,
# or default. Reading one message is a small task; low keeps it quick.
MOAT_INTENT_EFFORT=low
# Keep it under the gateway's intent_api.reader_timeout_secs, so the reader
# answers "unavailable" before the gateway gives up on it.
MOAT_INTENT_TIMEOUT_SECS=45
MOAT_INTENT_API_KEY=

# The local Gemma, through llama-server or the Colab queue (no key):
# MOAT_INTENT_PROVIDER=llama
# MOAT_INTENT_LLM_URL=http://127.0.0.1:8093
# MOAT_INTENT_MODEL=gemma-4-E4B-it-qat-UD-Q4_K_XL
# MOAT_INTENT_TIMEOUT_SECS=130

# Any OpenAI-compatible chat completions API (OpenAI, OpenRouter, Groq,
# Together, vLLM, ...). It must support json_schema response formats.
# MOAT_INTENT_PROVIDER=openai
# MOAT_INTENT_LLM_URL=https://api.openai.com
# MOAT_INTENT_MODEL=<the provider's model id>
# MOAT_INTENT_API_KEY=
