[Unit]
Description=Moat intent reader
After=network-online.target moat-colab-queue-api.service
Wants=network-online.target

[Service]
Type=simple
User=moat
Group=moat
WorkingDirectory=/var/lib/moat
# Which model reads is chosen in /etc/moat/moat-intent.env and nowhere else,
# so no default here can mix with it. The file is root-only: it can hold an
# API key. See deploy/moat-intent.env.example.
EnvironmentFile=/etc/moat/moat-intent.env
ExecStart=/usr/local/bin/moat-intent --listen 127.0.0.1:7083 --gateway http://127.0.0.1:7082
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
