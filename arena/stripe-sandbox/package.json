{
  "name": "@moat/stripe-sandbox",
  "private": true,
  "version": "0.1.0",
  "description": "Stripe test-mode MCP payment server for Moat demonstrations.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "smoke": "node --env-file=../../.env.stripe-sandbox --import tsx src/smoke.ts",
    "workflow": "node --env-file=../../.env.stripe-sandbox --import tsx src/supplier-workflow.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  }
}
